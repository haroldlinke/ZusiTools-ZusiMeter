<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>9.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AssemblyTitle>ZusiMeterKonfigurator</AssemblyTitle>
    <Copyright>Copyright © 2017-2024 Holger Maaß, Harold Linke</Copyright>
    <ApplicationIcon>Resources\zusimeterkonfigurator.ico</ApplicationIcon>
    <StartupObject>ZusiMeterKonfigurator.Startup</StartupObject>
   </PropertyGroup>
  <ItemGroup>
    <Content Include="Resources\zusimeterkonfigurator.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.2.0" />
    <PackageReference Include="Sovoma" Version="6.2.1" />
    <PackageReference Include="Sovoma.WPF" Version="6.7.3" />
    <PackageReference Include="ZusiFahrpultLib" Version="6.2.1" />
    <PackageReference Include="ZusiKlassenLib" Version="6.3.2" />
    <PackageReference Include="ZusiMeterGaugesLib" Version="6.3.11" />
    <PackageReference Include="Zusisuplib" Version="1.0.6" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="log4net" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="about\lgplv3_logo.png" />
    <Resource Include="images\bkgnd.png" />
    <Resource Include="images\graphic.jpg" />
    <Resource Include="images\listviewitem.png" />
    <Resource Include="images\textbased.jpg" />
    <Resource Include="images\window_bkgnd.png" />
    <Resource Include="images\window_bkgnd_blue.png" />
    <Resource Include="Resources\zusimeterkonfigurator.ico" />
    <Resource Include="zusimeter.xsd" />
    <Resource Include="GaugePool.xml" />
  </ItemGroup>
</Project>