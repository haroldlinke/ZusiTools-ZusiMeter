<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:scv="clr-namespace:Sovoma.WPF.Converter;assembly=Sovoma.WPF"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/ZusiMeterKonfigurator;component/Themes/Generic.LayoutGrid.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <scv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  <scv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
  <scv:ReverseBoolToVisibilityConverter x:Key="ReverseBoolToVisibilityConverter"/>
  <Color x:Key="CaptionColor" A="255" R="0" G="122" B="204"/>
  <SolidColorBrush x:Key="CaptionBrush" Color="CornflowerBlue"/>
  <ImageBrush x:Key="NewBackgroundBrush" ImageSource="/ZusiMeterKonfigurator;component/Images/bkgnd.png"/>
  <Style TargetType="{x:Type xc:MessageBox}">
    <Setter Property="xc:MessageBox.YesButtonContent" Value="Ja"/>
    <Setter Property="xc:MessageBox.NoButtonContent" Value="Nein"/>
    <Setter Property="xc:MessageBox.CancelButtonContent" Value="Abbrechen"/>
  </Style>
</ResourceDictionary>