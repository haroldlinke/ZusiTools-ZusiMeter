<Window x:Class="ZusiMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiMeter"
        xmlns:pg="clr-namespace:ZusiMeter.Pages"
        xmlns:data="clr-namespace:ZusiMeter.Data"
        xmlns:cv="clr-namespace:ZusiMeter.Converter"
        xmlns:c="clr-namespace:ZusiMeterGaugesLib.Controls;assembly=ZusiMeterGaugesLib"
        xmlns:sl="clr-namespace:Sovoma;assembly=Sovoma"
        xmlns:v="clr-namespace:ZusiMeter.ValidationRules"
        x:Name="mainWindow" SnapsToDevicePixels="true" UseLayoutRounding="true"
        SizeToContent="WidthAndHeight" ResizeMode="CanResize" WindowStyle="ThreeDBorderWindow"
        Background="{DynamicResource NewBackgroundBrush}" Icon="Resources\zusimeter.ico"
        Title="{Binding Source={x:Static sl:AsmInfo.Product}}"
        DataContext="{Binding Source={x:Static data:DataManager.Instance}}"
        >
    <!--DataContext="{Binding RelativeSource={RelativeSource Self}}"-->
  <FrameworkElement.Resources>
        <ResourceDictionary/>
    </FrameworkElement.Resources>
  <Grid>
     
    <DockPanel x:Name="mainPanel">
            <Menu VerticalAlignment="Top" Grid.ColumnSpan="2" DockPanel.Dock="Top" Padding="0,3">
                <Control.Background>
                    <LinearGradientBrush>
                        <GradientStop Offset="0" Color="#FF76A8FF"/>
                        <GradientStop Offset="1" Color="#FF6A9BF3"/>
                    </LinearGradientBrush>
                </Control.Background>
                <MenuItem Header="_Datei">
                    <MenuItem Command="{x:Static local:MainWindow.CommandNewGraphicLayout}"/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandNewTextLayout}"/>
                    <Separator/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandLoadLayout}"/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandLoadLayoutEdit}"/>
                    <MenuItem Command="{x:Static pg:EditorPage.CommandSaveLayout}"
                                CommandTarget="{Binding ElementName=editorPage}"/>
                    <MenuItem Command="{x:Static pg:EditorPage.CommandSaveAsLayout}"
                                CommandTarget="{Binding ElementName=editorPage}"/>
                    <Separator/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandOpenLayout}"/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandLoadOtherLayout}"/>
                    <Separator/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandBack}"/>
                    <Separator/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandQuit}"/>
                </MenuItem>
                <MenuItem Header="_Bearbeiten" Visibility="{Binding Visibility, ElementName=editorPage}">
                    <!--<MenuItem Command="{x:Static pg:EditorPage.CommandUndo}" CommandTarget="{Binding ElementName=editorPage}"/>
                    <Separator/>-->
                    <MenuItem Command="{x:Static pg:EditorPage.CommandRemoveGauge}"
                              CommandTarget="{Binding ElementName=editorPage}"/>
                    <!--<Separator/>
                    <MenuItem Header="_Eigenschaften" IsEnabled="false"/>-->
                </MenuItem>
                <MenuItem Header="_Einstellungen">
                    <MenuItem Command="{x:Static local:MainWindow.CommandOptions}" CommandTarget="{Binding ElementName=window}"/>
                </MenuItem>
                <MenuItem Header="_Info">
                    <MenuItem Command="{x:Static local:MainWindow.CommandAbout}" CommandTarget="{Binding ElementName=window}"/>
                    <MenuItem Command="{x:Static local:MainWindow.CommandHelp}" CommandTarget="{Binding ElementName=window}"/>
                </MenuItem>
            </Menu>
            <StatusBar MouseRightButtonDown="StatusBar_MouseRightButtonDown" DockPanel.Dock="Bottom">
        <!--<StatusBarItem>
          --><!--<CheckBox Checked="CbxIPBoard_Checked" x:Name="cbxIPBoard" ToolTip="Zusi-Verbindung"
                    Visibility="{Binding IsIPBoardSwitchVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type CheckBox}">
                <Setter Property="FrameworkElement.Width" Value="11"/>
                <Setter Property="FrameworkElement.Height" Value="7"/>
                <Setter Property="Control.Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                      <Border>
                        <Path x:Name="glyph" Stretch="Fill" Fill="Black" Stroke="Black" Data="M 0.5,0.5 L 10.5,0.5 5.5,6.5 Z"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                          <Setter TargetName="glyph" Property="Path.Data" Value="M 0.5,6.5 L 10.5,6.5 5.5,0.5 Z"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </CheckBox>--><!--
        </StatusBarItem>-->
        <StatusBarItem>
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding SelectLayout, Converter={StaticResource ReverseBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <ToggleButton Width="12" Height="12" BorderThickness="0" ToolTip="Fenster immer sichtbar"
                          Style="{DynamicResource TopmostToggleButtonStyle}"
                          IsChecked="{Binding Topmost, ElementName=mainWindow, Mode=TwoWay}"/>
            <Button Width="12" Height="12" Margin="12,0,0,0" BorderThickness="0" ToolTip="Zeitraffer"
                    Style="{DynamicResource TimelapseButtonStyle}"
                    Command="{x:Static local:MainWindow.CommandTimelapse}"/>
            <Button Width="12" Height="12" Margin="6,0,0,0" BorderThickness="0" ToolTip="Pause"
                    Style="{DynamicResource PauseButtonStyle}" Command="{x:Static local:MainWindow.CommandPause}"/>
            <Button Width="12" Height="12" Margin="6,0,0,0" BorderThickness="0" ToolTip="Zeitsprung"
                    Style="{DynamicResource TimejumpButtonStyle}" Command="{x:Static local:MainWindow.CommandTimejump}"/>
            <!--<Button Width="12" Height="12" Margin="12,0,0,0" BorderThickness="0" ToolTip="Layout-Auswahl"
                    Style="{DynamicResource BackButtonStyle}" Command="{x:Static local:MainWindow.CommandBack}"/>
            <Button Width="12" Height="12" Margin="12,0,0,0" BorderThickness="0" ToolTip="Zu ZUSI AutoStart hinzufügen"
                    Style="{DynamicResource SendToAutoStartButtonStyle}" Command="{x:Static local:MainWindow.CommandSendToAutoStart}"/>-->
                    </StackPanel>
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Die Zusi-Verbindung ist nicht konfiguriert!" Foreground="#FFDA0000"
                       Visibility="{Binding MissingConfiguration, Converter={StaticResource BoolToVisibilityConverter}, ElementName=mainWindow}"/>
            <TextBlock Text=" " Margin="0,0,6,0" VerticalAlignment="Center"/>

            <Ellipse Width="12" Height="12" Stroke="Black" Margin="0,0,3,0" x:Name="IPStatus"
                     Fill="{Binding ZusiConnectionState, Converter={StaticResource Int2BrushConverter}, ElementName=mainWindow, Mode=OneWay}"         
                     ToolTip="{Binding ZusiConnectionString, ElementName=mainWindow, Mode=OneWay}">
                     <Ellipse.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Verbindung einstellen" Command="{x:Static local:MainWindow.CommandOptions}" CommandTarget="{Binding ElementName=window}"/>
                         </ContextMenu>
                      </Ellipse.ContextMenu>
             </Ellipse>
           </StackPanel>
        </StatusBarItem>
      </StatusBar>
      <Border>
        <Grid>
          <Grid x:Name="layoutGrid"
                Visibility="{Binding SelectLayout, Converter={StaticResource ReverseBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"
                Background="{Binding ElementName=mainWindow, Path=LayoutBackground.Background, Mode=OneWay}">
            <FrameworkElement.LayoutTransform>
              <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding Zoom, ElementName=mainWindow, Mode=OneWay}"
                              ScaleY="{Binding Zoom, ElementName=mainWindow, Mode=OneWay}"/>
            </FrameworkElement.LayoutTransform>
          </Grid>
          <!--<Border MinWidth="200" MinHeight="100"
                  Visibility="{Binding SelectLayout, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Foreground="Gold" FontStyle="Italic" FontWeight="Bold" FontSize="20" Margin="12,6,0,0"
                         Grid.ColumnSpan="3" Text="{Binding Source={x:Static sl:AsmInfo.Product}}">
                <UIElement.Effect>
                  <DropShadowEffect ShadowDepth="1"/>
                </UIElement.Effect>
              </TextBlock>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="11,0,0,0" Foreground="WhiteSmoke">
                <Run Text="Version"/>
                <Run Text="{Binding ConverterParameter=%V, Converter={StaticResource VersionStringConverter}, Source={x:Static sl:AsmInfo.Version}, Mode=OneWay}"/>
                <Run Text=" • "/>
                <Run Text="{Binding Source={x:Static sl:AsmInfo.Copyright}, Mode=OneWay}"/>
              </TextBlock>
              <StackPanel Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="1"
                          Orientation="Horizontal" Grid.Column="2" Grid.RowSpan="2" Visibility="Collapsed">
                <Button Margin="0,0,6,0" Command="{x:Static local:MainWindow.CommandMinimizeApp}"
                        Style="{DynamicResource MinimizeButtonStyle}"/>
                <Button Command="{x:Static local:MainWindow.CommandExitApp}" Style="{DynamicResource ExitAppButtonStyle}"/>
              </StackPanel>
              <Border BorderThickness="1" BorderBrush="#FFABADB3" Grid.Row="2" Padding="3" Grid.Column="2"
                      Margin="0,26,6,34"
                      Background="{Binding ElementName=mainWindow, Path=LayoutBackground.Background, Mode=OneWay}">
                <Viewbox StretchDirection="Both" Width="200" Height="205">
                  <c:LayoutPreview x:Name="preview"/>
                </Viewbox>
              </Border>
              <Border Padding="6,0,6,3" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" >
                <Grid Height="270">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Label Content="Layout öffnen" Grid.ColumnSpan="2" Foreground="WhiteSmoke"/>
                  <ListView SelectionChanged="LvLayoutFiles_SelectionChanged" x:Name="lvLayoutFiles" Grid.Row="1"
                            MaxWidth="440" SelectionMode="Single" IsSynchronizedWithCurrentItem="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" Background="#26FFFFFF"
                            ItemsSource="{Binding LayoutFiles, ElementName=mainWindow}">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ListViewItem}">
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="3,0,0,0" Width="64" ToolTip="{Binding Converter={StaticResource ExtractFilenameConverter}}">
                          <StackPanel.ContextMenu>
                            <ContextMenu>
                             <MenuItem Header="Layout laden" Command="{x:Static local:MainWindow.CommandLoadLayout}"/>
                             <MenuItem Header="Layout zu ZUSI-Autostart hinzufügen" Command="{x:Static local:MainWindow.CommandSendToAutoStart}"/>
                            </ContextMenu>
                          </StackPanel.ContextMenu>
                          <Image Source="Images/listviewitem.png" Margin="0,0,0,3"
                            HorizontalAlignment="Center" Stretch="None"/>
                          <TextBlock HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                Text="{Binding Converter={StaticResource ExtractFilenameConverter}}"/>
                      </StackPanel>
                    </DataTemplate>
                   </ItemsControl.ItemTemplate>
                  </ListView>
                  <Button Command="{x:Static local:MainWindow.CommandLoadLayout}" Grid.Row="3" Margin="0,3,0,4"
                          Grid.Column="1" HorizontalAlignment="Right" IsDefault="true"
                          Style="{DynamicResource DialogButtonStyle}"/>
                  <Button Command="{x:Static local:MainWindow.CommandLoadOtherLayout}" IsDefault="true"
                          HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Margin="0,3,0,4"
                          Style="{DynamicResource DialogButtonStyle}"/>
                </Grid>
              </Border>
            </Grid>
          </Border>-->
        </Grid>
      </Border>
            <Grid>
                <pg:StartPage x:Name="startPage" Visibility="{Binding SelectLayout, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"/>
                <pg:EditorPage x:Name="editorPage" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
  </Grid>
</Window>